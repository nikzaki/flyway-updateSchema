CREATE OR REPLACE VIEW gv_user_profile AS
    SELECT
        auth.id AS user_id,
        auth.user_name,
        auth.name AS auth_name,
        auth.email,
        auth.is_active,

        uf.salutation,
        uf.first_name,
        uf.last_name,
        uf.name AS profile_name,
        uf.profile_image,
        uf.gender,
        uf.date_of_birth,
        uf.occupation,
        uf.religion,
        uf.race,
        uf.married,
        uf.marriage_date,
        uf.photo,
        uf.fk_nationality,
        uf.share_with_club,
        uf.share_with_others,

        ua.fk_address,
        ua.address_name,

        pl.player_id,

        roles.club_id,
        roles.club_group_id,
        cg.name AS club_group_name,
        roles.organizer_id,
        roles.partner_id

    FROM gs_authentication auth

-- 1. Standard joins for 1:1 user profile and address data
             LEFT JOIN gs_user_profile uf ON auth.id = uf.fk_user
             LEFT JOIN gs_user_address ua ON auth.id = ua.fk_user AND ua.default_address = 'Y'

        -- 2. Safely get the Player ID (Replaces the LIMIT 1 subquery)
-- Using MIN(id) + GROUP BY guarantees we only get 1 row per user, preventing duplicates
             LEFT JOIN (
        SELECT fk_authentication, MIN(id) AS player_id
        FROM gs_player
        GROUP BY fk_authentication
    ) pl ON pl.fk_authentication = auth.id

-- 3. Read the Role table exactly ONCE and pivot the data
             LEFT JOIN (
        SELECT
            fk_authentication,
            MAX(IF(fk_role = 'ROLE_CLUB', fk_club, NULL)) AS club_id,
            MAX(IF(fk_role = 'ROLE_CLUB_GROUP', fk_club_group, NULL)) AS club_group_id,
            MAX(IF(fk_role = 'ROLE_ORGANIZER', fk_organizer, NULL)) AS organizer_id,
            MAX(IF(fk_role = 'ROLE_PARTNER', fk_partner, NULL)) AS partner_id
        FROM gs_user_role
        GROUP BY fk_authentication
    ) roles ON roles.fk_authentication = auth.id

-- 4. Cleanly get the Club Group Name using the ID we just pivoted
             LEFT JOIN gs_club_group cg ON cg.id = roles.club_group_id;


CREATE OR REPLACE VIEW gv_consolidated_product_package AS
    SELECT pkg.*
    FROM gs_product_package pkg
             JOIN gs_club club ON club.id = pkg.fk_club
             LEFT JOIN gs_product_price prod_price ON prod_price.fk_product_package = pkg.id AND prod_price.start_date <= CURDATE() AND prod_price.end_date >= CURDATE()
    WHERE pkg.consolidated_price = 'Y';



create or replace view gv_league_season_participant as
    select lr.id,
           lr.fk_player,
           lr.fk_league_season,
           fk_player_group,
           fk_competition_stream,
           lr.fk_competition_player_category,
           'player' as participation_type,
           ai.additional_info,
           ai.created_at,
           ai.last_updated_at,
           ai.created_by,
           auth_create.name created_by_name,
           ai.last_updated_by,
           auth_update.name updated_by_name,
           lstp.fk_league_season_team fk_team,
           lr.handicap,
           lr.handicap_index,
           lr.fk_participating_club
    FROM gs_league_roster lr
             LEFT JOIN gs_league_season_team_player lstp
                       ON lstp.fk_league_roster = lr.id

             LEFT JOIN gs_competition_player_addl_info ai
                       ON ai.fk_league_season = lr.fk_league_season AND ai.fk_player = lr.fk_player
             LEFT JOIN gs_authentication auth_create
                       ON ai.created_by = auth_create.id
             LEFT JOIN gs_authentication auth_update
                       ON ai.last_updated_by = auth_update.id
    UNION
    SELECT sg.id,
           sg.fk_player,
           sg.fk_league_season,
           fk_player_group,
           null    as fk_competition_stream,
           null    as fk_competition_player_category,
           'guest' as participation_type,
           additional_info,
           ai.created_at,
           ai.last_updated_at,
           ai.created_by,
           auth_create.name created_by_name,
           ai.last_updated_by,
           auth_update.name updated_by_name,
           null as fk_team,
           null as handicap,
           null as handicap_index,
           sg.fk_participating_club
    FROM gs_league_season_guest sg
             LEFT JOIN gs_competition_player_addl_info ai
                       ON ai.fk_league_season = sg.fk_league_season AND ai.fk_player = sg.fk_player
             LEFT JOIN gs_authentication auth_create
                       ON ai.created_by = auth_create.id
             LEFT JOIN gs_authentication auth_update
                       ON ai.last_updated_by = auth_update.id;
