
-- 30 Dec 2025
create or replace view gv_club_transaction_type as
    select concat_ws('_', club.id, tt.id) trxn_type_key,  club.id club_id, club_name,
           tt.id transaction_type_id, tt.name transaction_type_name, tt.debit_or_credit, tt.description,
           if(tt.fk_club is null, 'Y', 'N') system_transaction_type, tt.used_for,
           ttcm.club_transaction_type,
           ttcm.debit_account_code, ttcm.credit_account_code,
           tt.fk_transaction_group, gs_transaction_group.name transaction_group_name
    FROM gs_transaction_type tt
             JOIN gs_club club ON club.id = tt.fk_club OR tt.fk_club is null
             LEFT JOIN gs_transaction_group ON gs_transaction_group.id = tt.fk_transaction_group
             LEFT JOIN gs_transaction_type_club_map ttcm ON ttcm.fk_transaction_type = tt.id AND ttcm.fk_club = club.id
    WHERE EXISTS(
        SELECT 'X' FROM gs_club_external_interface cei
                            JOIN gs_external_system es ON es.id = cei.fk_external_system
        WHERE cei.fk_club = club.id AND es.system_type = 'ACCOUNTING'
    );


    
CREATE OR REPLACE VIEW gv_user_authentication AS
    SELECT
        auth.id, auth.user_name, auth.password, auth.encryption_algorithm,
        auth.salt, auth.combine_username, auth.email, auth.phone, auth.is_active,
        auth.name, auth.token_key, auth.account_delete_request,
        auth.delete_requested_on, auth.account_deleted, auth.deleted_on,

        -- 1. Pulled from our single Pivoted Role derived table
        roles.user_roles,
        roles.is_admin,

        roles.user_club_id,
        clb.club_name AS user_club_name,

        roles.user_club_group_id,
        cg.name AS user_club_group_name,
        roles.clubs_allowed,

        roles.user_organizer_id,
        org.name AS user_organizer_name,

        roles.user_partner_id,
        par.name AS user_partner_name,

        -- 2. From standard JOINs
        pl.id AS player_id,
        pl.player_name AS user_player_name,

        prof.salutation, prof.first_name, prof.last_name, prof.name profile_name, prof.profile_image, prof.photo,
        prof.gender, prof.date_of_birth, prof.occupation, prof.religion,
        prof.race, prof.married, prof.marriage_date,
        prof.share_with_club, prof.share_with_others, prof.fk_nationality,

        addr.address_name,

        ad.fk_country, ad.address_line_1, ad.address_line_2, ad.city,
        ad.postal_code, ad.state_province, ad.phone_numbers, ad.fax, ad.website

    FROM gs_authentication auth

-- 3. THE FIX: Read gs_user_role ONCE and pivot the IDs and flags
             LEFT JOIN (
        SELECT
            fk_authentication,
            GROUP_CONCAT(fk_role) AS user_roles,
            MAX(IF(fk_role = 'ROLE_ADMIN', 'Y', NULL)) AS is_admin,
            MAX(IF(fk_role = 'ROLE_CLUB', fk_club, NULL)) AS user_club_id,
            MAX(IF(fk_role = 'ROLE_CLUB_GROUP', fk_club_group, NULL)) AS user_club_group_id,
            MAX(IF(fk_role = 'ROLE_ORGANIZER', fk_organizer, NULL)) AS user_organizer_id,
            MAX(IF(fk_role = 'ROLE_PARTNER', fk_partner, NULL)) AS user_partner_id,
            MAX(IF(fk_role = 'ROLE_CLUB_GROUP', clubs_allowed, NULL)) AS clubs_allowed
        FROM gs_user_role
        GROUP BY fk_authentication
    ) roles ON roles.fk_authentication = auth.id

-- 4. Clean LEFT JOINs to get the names using the IDs we just pivoted
             LEFT JOIN gs_club clb ON clb.id = roles.user_club_id
             LEFT JOIN gs_club_group cg ON cg.id = roles.user_club_group_id
             LEFT JOIN gs_organizer org ON org.id = roles.user_organizer_id
             LEFT JOIN gs_discount_company par ON par.id = roles.user_partner_id

-- 5. Existing 1:1 data joins (Unchanged, already optimal)
             LEFT JOIN gs_player pl ON pl.fk_authentication = auth.id
             LEFT JOIN gs_user_profile prof ON prof.fk_user = auth.id
             LEFT JOIN gs_user_address addr ON addr.fk_user = auth.id AND addr.default_address = 'Y'
             LEFT JOIN gs_address ad ON ad.id = addr.fk_address;


